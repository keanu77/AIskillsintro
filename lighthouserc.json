{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=4176 node scripts/serve-static.mjs",
      "startServerReadyPattern": "serving",
      "url": [
        "http://localhost:4176/",
        "http://localhost:4176/skills/scanpy",
        "http://localhost:4176/skills/claude-api",
        "http://localhost:4176/updates",
        "http://localhost:4176/?view=list"
      ],
      "numberOfRuns": 5,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
